{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "filmparadise-bd",
  "compatibility_date": "2026-09-14",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "filmparadise-bd",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "POSTERS",
      "bucket_name": "filmparadise-posters"
    }
  ]
}
